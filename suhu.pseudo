DECLARE Celcius : REAL 
DECLARE Kelvin : REAL
DECLARE Fahrenheit : REAL
DECLARE Reamour : REAL

INPUT Celcius
IF Celcius = "" THEN
    OUTPUT "Harus berupa angka atau bilangan positif"
ELSE 
Kelvin <-- Celcius + 273.15
Fahrenheit <-- (Celcius * 9/5) + 32
Reamour <-- Celcius * 4/5

OUTPUT Kelvin
OUTPUT Fahrenheit
OUTPUT Reamour
ENDIF
